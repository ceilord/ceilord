{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ceilord",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "ceilord.com",
      "custom_domain": true
    },
    {
      "pattern": "www.ceilord.com",
      "custom_domain": true
    }
  ],
  "env": {
    "dev": {
      "name": "ceilord-dev",
      "routes": [],
      "vars": {
        "SITE_ENV": "dev"
      },
      "ratelimits": [
        {
          "name": "BETA_RATE_LIMITER",
          "namespace_id": "720002",
          "simple": {
            "limit": 40,
            "period": 60
          }
        }
      ]
    },
    "staging": {
      "name": "ceilord-staging",
      "routes": [],
      "vars": {
        "SITE_ENV": "staging"
      },
      "ratelimits": [
        {
          "name": "BETA_RATE_LIMITER",
          "namespace_id": "720003",
          "simple": {
            "limit": 40,
            "period": 60
          }
        }
      ]
    }
  },
  "ratelimits": [
    {
      "name": "BETA_RATE_LIMITER",
      "namespace_id": "720001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
